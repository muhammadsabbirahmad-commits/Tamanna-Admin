rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin_registry/primary)
        && get(/databases/$(database)/documents/admin_registry/primary).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/admin_registry/primary).data.role == 'admin';
    }

    match /admin_registry/primary {
      allow read: if request.auth != null
                    && (
                      !exists(/databases/$(database)/documents/admin_registry/primary)
                      || resource.data.uid == request.auth.uid
                    );
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/admin_registry/primary)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == 'admin';
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.role == 'admin';
      allow delete: if false;
    }

    match /admin_data/partners/{partnerId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}