rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin_registry/primary)
        && get(/databases/$(database)/documents/admin_registry/primary).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/admin_registry/primary).data.role == 'admin';
    }

    match /admin_registry/primary {
      // The client reads this server-provisioned record, then verifies UID/role.
      // Clients can never create, update, or delete the Admin registry.
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /admin_data/partners/items/{partnerId} {
      allow read, write: if isAdmin();
    }

    match /admin_audit/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.eventId == eventId;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
