rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin_registry/primary)
        && get(/databases/$(database)/documents/admin_registry/primary).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/admin_registry/primary).data.role == 'admin';
    }

    match /admin_registry/primary {
      allow read: if request.auth != null
                    && (
                      !exists(/databases/$(database)/documents/admin_registry/primary)
                      || resource.data.uid == request.auth.uid
                    );
      // The primary Admin identity must be provisioned server-side.
      // Clients must never be able to self-claim or modify the Admin registry.
      allow create, update, delete: if false;
      allow delete: if false;
    }

    match /admin_data/partners/items/{partnerId} {
      allow read, write: if isAdmin();
    }

    match /admin_audit/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.eventId == eventId;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}