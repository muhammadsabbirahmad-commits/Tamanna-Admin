rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Permanent Admin identity.
    // The first authenticated user may create this document once.
    // Once it exists, only that UID may read or update it.
    match /admin_registry/primary {
      allow read: if request.auth != null
                    && (
                      !exists(/databases/$(database)/documents/admin_registry/primary)
                      || resource.data.uid == request.auth.uid
                    );

      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/admin_registry/primary)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == 'admin';

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.role == 'admin';

      allow delete: if false;
    }

    // No other Firestore data is exposed by the Admin app yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}