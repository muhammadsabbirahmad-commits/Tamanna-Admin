<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Settings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tamanna Admin control panel"
            android:textSize="16sp"
            android:paddingBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Account"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvAdminEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Gmail: Not connected"
            android:textSize="16sp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvAdminStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Status: NOT CONNECTED"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>

        <Button
            android:id="@+id/btnConnectAdminGmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect Admin Gmail"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="প্রথমবার সংযুক্ত Gmail-ই Admin Gmail হিসেবে স্থায়ী থাকবে। অন্য Gmail দিয়ে পরিবর্তন করা যাবে না।"
            android:textSize="14sp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Security"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Master PIN: Protected&#10;Admin-only controls: Enabled"
            android:textSize="16sp"
            android:paddingBottom="20dp"/>

        <TextView
            android:id="@+id/tvSettingsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin settings ready"
            android:textSize="16sp"
            android:paddingBottom="16dp"/>

        <Button
            android:id="@+id/btnRefreshSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refresh Settings"/>

        <Button
            android:id="@+id/btnAdminLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Admin Logout"/>
    </LinearLayout>
</ScrollView>
