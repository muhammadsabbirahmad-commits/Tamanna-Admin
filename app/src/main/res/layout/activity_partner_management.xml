<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="#F5F7FA">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Partner Management" android:textSize="26sp" android:textStyle="bold" android:textColor="#146B4A"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Approve, suspend or remove partners" android:textSize="15sp" android:textColor="#666666"/>
<Button android:id="@+id/btnAddPartner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Add Partner Request"/>
<TextView android:id="@+id/tvEnterprisePartnerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Enterprise Partner server data loading..." android:textColor="#666666" android:textSize="14sp"/><Button android:id="@+id/btnRefreshEnterprisePartners" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Refresh Enterprise Partners"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Enterprise Business Partners" android:textSize="21sp" android:textStyle="bold" android:textColor="#146B4A"/><ListView android:id="@+id/lvEnterprisePartners" android:layout_width="match_parent" android:layout_height="280dp" android:layout_marginTop="8dp"/><TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:gravity="center" android:text="No partner requests yet" android:textColor="#777777" android:textSize="16sp"/>
<ListView android:id="@+id/lvPartners" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"/>
</LinearLayout>